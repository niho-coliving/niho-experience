# Copy to .env.local only if you need to change a default. No secrets belong here.

# "mock" (default) uses synthetic fixtures. "http" is reserved for the NIHO
# public API once the contract (#7) and integration A are agreed; it is not
# connected yet and will fail on purpose.
EXPERIENCE_API_MODE=mock
# EXPERIENCE_API_BASE_URL=https://api.example.invalid

# Artificial latency for the mock, in ms, to review loading states.
MOCK_LATENCY_MS=0

# Canonical origin used for metadata and the sitemap. The production domain is
# not decided yet.
SITE_URL=http://localhost:3000

# Search engines are blocked unless this is exactly "allow" (production only,
# after acceptance in #15).
SITE_INDEXING=block

# Provider entry (#11). "pilot" = invitation only, no self sign-up shown.
# "open" = link to NIHO sign-in (needs integration B).
HOST_SIGNUP_MODE=pilot
# NIHO_HOST_START_URL=
# HOST_PILOT_CONTACT_URL=

# Where guests check a booking on NIHO after payment (integration A).
# NIHO_BOOKING_HELP_URL=
