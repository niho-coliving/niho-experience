  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "next-env.d.ts",
    "src/app/(site)/page.tsx",
    "src/app/(site)/help/page.tsx",
    "src/app/(site)/host/page.tsx",
