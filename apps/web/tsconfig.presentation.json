    "src/components/SlotPicker.tsx",
    "src/components/DetailBooking.tsx",
    "src/components/DetailGallery.tsx",
    "src/components/ExperienceCard.tsx",
    "src/components/PresentationV1.tsx",
    "src/components/PresentationGalleryV1.tsx",
    "src/components/SiteChrome.tsx",
    "src/components/ui.tsx"
