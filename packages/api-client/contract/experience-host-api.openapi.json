{
  "openapi": "3.0.3",
  "info": {
    "title": "NIHO Experience Host API",
    "version": "0.1.0",
    "description": "niho-experience のホストの画面（/host）が、ホスト本人の ID token（Bearer）で使う NIHO の API（選別して配布する版）。正本は niho-app の contracts/openapi.yaml。ここに無い項目・操作は使わない。",
    "x-niho-contract-status": "draft",
    "x-niho-contract-source": "niho-app contracts/openapi.yaml"
  },
  "servers": [
    {
      "url": "https://niho.life",
      "description": "NIHO の Web origin（stg は https://app-stg.niho.life）"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "認証、セッション解決、本人確認まわりの API。"
    },
    {
      "name": "ExperienceProvider",
      "description": "体験の提供者（外部提供者）の本人向け API。体験サイトのホストの画面と niho.life の提供者の画面が、ログイン中の本人として呼ぶ。\n権限は提供者の中の役割（OWNER / EDITOR）か platform ADMIN で決まり、所属していない提供者は区別せず 404。応答は `Cache-Control: private, no-store`。\n"
    }
  ],
  "paths": {
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "自分のユーザー情報・所属情報を取得",
        "operationId": "getAuthMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceHostAuthMe"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers": {
      "get": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "自分が所属する体験の提供者の一覧",
        "description": "ログイン中の本人が OWNER / EDITOR として所属する提供者を、登録の古い順に 200 件まで返す（platform ADMIN は全提供者）。\n`memberRole` は本人の役割（platform ADMIN で所属していなければ null）。`consent` は提供者の登録の同意、\n`paymentReuseConsent` は既存の拠点の販売者口座を売上の受取に再利用するときの同意（版と画面に出す文言）。\n",
        "operationId": "listExperienceProviders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      },
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "体験の提供者として自己登録する",
        "description": "本人を OWNER とする提供者を作る（招待はない）。登録直後の審査の状態は `DRAFT`。\n`consentVersion` は一覧・詳細の `consent.version` と一致が必須。予約の通知先には本人の認証のメール（無ければアカウントの登録メール）を使う。\n422 の `error.details.reason`: `PROVIDER_CONSENT_OUTDATED`（同意の版が古い）・`PROVIDER_EMAIL_REQUIRED`（通知先のメールが無い）。\n",
        "operationId": "registerExperienceProvider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceProviderRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "登録した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderRegisterResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "get": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "体験の提供者の紹介を読む",
        "description": "OWNER / EDITOR（platform ADMIN は全提供者）が読む。所属していない・存在しない提供者は区別せず 404。\n`provider` は読む間に消えたときだけ null。\n",
        "operationId": "getExperienceProvider",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      },
      "patch": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "体験の提供者の紹介を直す",
        "description": "OWNER / EDITOR（platform ADMIN）が紹介を直す。`sellerDisclosureUrl` を含む変更は OWNER と platform ADMIN だけで、EDITOR は 403。\n直すと、審査が `APPROVED` / `SUSPENDED` の提供者は `REQUESTED`（再審査）に戻り、掲載中の体験は止まる（`PAUSED`）。\n項目が 1 つも無い本文・知らない項目は 400。所属していない・存在しない提供者は 404。\n",
        "operationId": "updateExperienceProvider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceProviderUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/submit": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "体験の提供者の審査を申請する",
        "description": "OWNER（platform ADMIN）が NIHO の審査を申請する。本文は読まない。審査が `DRAFT` / `REQUESTED` で、`sellerDisclosureUrl`（https）があり、\n登録の同意が今の版のときだけ `REQUESTED` にする。それ以外は 409（`error.details.reason`: `PROVIDER_REVIEW_STATE_CONFLICT`）。\nEDITOR・所属していない提供者は 404。\n",
        "operationId": "submitExperienceProvider",
        "responses": {
          "200": {
            "description": "申請した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderSubmitResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/readiness": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "get": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "体験の提供者の売上の受取口座の準備の状態",
        "description": "OWNER（platform ADMIN）が、売上の受取口座（Stripe の連結アカウント）の準備の状態を読む。口座の ID・本人確認の項目は返さない。\nEDITOR・所属していない提供者は 404。\n",
        "operationId": "getExperienceProviderPaymentReadiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderPaymentReadinessResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/reuse-candidates": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "get": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "売上の受取に再利用できる拠点の販売者口座の候補",
        "description": "OWNER（platform ADMIN）が読む。本人が現役の OWNER である通常の拠点ごとに、その販売者口座の準備の状態を返す\n（`ready: true` の拠点だけ再利用できる）。EDITOR・所属していない提供者は 404。\n",
        "operationId": "listExperienceProviderPaymentReuseCandidates",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderPaymentReuseCandidatesResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/reuse": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "拠点の販売者口座を体験の売上の受取に再利用する",
        "description": "提供者の OWNER が、自分が現役の OWNER である拠点（`sourceSpotId`）の準備済みの販売者口座を、この提供者の売上の受取に共有する。\n拠点の側の口座・設定は変えない。掲載中の体験は止まる（`PAUSED`）。`consentVersion` は `paymentReuseConsent.version` と一致が必須。\n404: 提供者の OWNER でない（platform ADMIN でも OWNER でなければ 404）・`sourceSpotId` の OWNER でない・拠点に口座が無い\n（`PROVIDER_PAYMENT_SOURCE_FORBIDDEN`）。409: 申込が 1 件でもある（`PROVIDER_PAYMENT_LOCKED`）。\n422: 同意の版が古い（`PROVIDER_PAYMENT_CONSENT_OUTDATED`）・拠点の口座の準備が済んでいない（`PROVIDER_PAYMENT_SOURCE_NOT_READY`）。\n理由は `error.details.reason` に入る。\n",
        "operationId": "reuseExperienceProviderPayment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperienceProviderPaymentReuseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "再利用した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/connect/start": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "売上の受取口座の Stripe の接続を始める",
        "description": "提供者の OWNER が、Stripe の口座の登録の画面（アカウントリンク）の URL を受け取る。口座が無ければ作る（同じ提供者では冪等）。本文は読まない。\n`url` は一度きりで `expiresAt` まで。Stripe から戻る先（`refresh_url` / `return_url`）は API の設定で決まり、体験サイトのホストの画面\n（env `EXPERIENCE_HOST_CONSOLE_URL`）があれば `<その URL>?providerId=…&connect=refresh|return`、無ければ niho.life の提供者の画面。\n応答には準備の状態（`ready` / `reason`）も入る。\n404: 提供者の OWNER でない（platform ADMIN でも OWNER でなければ 404）。409: 決済の接続を使えない（`PROVIDER_CONNECT_UNAVAILABLE`）・\n拠点の口座を再利用している（`PROVIDER_PAYMENT_SHARED_ACCOUNT`）・口座が無いまま申込がある（`PROVIDER_PAYMENT_LOCKED`）。\n理由は `error.details.reason` に入る。\n",
        "operationId": "startExperienceProviderPaymentConnect",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderPaymentConnectResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/connect/resume": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "売上の受取口座の Stripe の接続を続ける",
        "description": "`start` と同じ処理（リンクの期限が切れた・Stripe の画面を途中で離れたときに、新しいリンクを受け取る）。応答・エラーも `start` と同じ。\n",
        "operationId": "resumeExperienceProviderPaymentConnect",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderPaymentConnectResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    },
    "/api/experience-providers/{providerId}/payments/connect/sync": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ExperienceProviderId"
        }
      ],
      "post": {
        "tags": [
          "ExperienceProvider"
        ],
        "summary": "売上の受取口座の状態を Stripe から取り直す",
        "description": "提供者の OWNER が、Stripe の口座の状態を取り直して保存し、準備の状態を返す（`url` / `expiresAt` は null）。本文は読まない。\n404 と 409 は `start` と同じで、加えて口座がまだ無ければ 409（`PROVIDER_PAYMENT_NOT_CONNECTED`）。\n",
        "operationId": "syncExperienceProviderPaymentConnect",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperienceProviderPaymentConnectResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "security": [
          {
            "FirebaseIdToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "FirebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "v1:\n- dev では `AUTH_MODE=mock` により `Authorization: Bearer mock:{firebaseUid}:{displayName?}` を受け付ける（同じ bearer scheme）。\n- prod では Firebase ID token（JWT）を想定する。\n"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "x-niho-experience-host-dto": true,
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "description": "エラーコード（実装の `ErrorCode` に準拠）",
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "BODY_JSON_TOO_LARGE",
                      "BODY_JSON_INVALID",
                      "MEMBER_BLOCK_INVALID",
                      "MEMBER_BLOCK_CROSS_SPOT_FORBIDDEN"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ExperienceHostAuthMe": {
        "x-niho-experience-host-dto": true,
        "type": "object",
        "description": "体験サイトのホストの画面が `GET /api/auth/me` から読む部分（表示名と顔写真）。応答の正は `AuthMeResponse` で、ほかの項目も入る\n（この schema は閉じない）。ホストの契約の書き出しでは、`getAuthMe` の 200 の schema をこれに置き換える。\n項目を足すときは `AuthMeResponse` に同じ名前・同じ型の項目があることを確かめる（contracts の test が見る）。\n",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "displayName"
            ]
          },
          "userIconImage": {
            "type": "object",
            "nullable": true,
            "description": "プロフィールの顔写真（短命の署名つき URL）。未設定は null",
            "properties": {
              "signedUrl": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "signedUrl",
              "expiresAt"
            ]
          }
        },
        "required": [
          "user",
          "userIconImage"
        ]
      },
      "ExperienceProvider": {
        "x-niho-experience-host-dto": true,
        "type": "object",
        "description": "体験の提供者（本人が読む形）",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "description": "登録した人の user ID（記録だけで、権限の根拠にしない。権限は memberRole）"
          },
          "vesselSpotId": {
            "type": "string",
            "description": "提供者の体験・予約・売上を入れる内部の器（拠点）の ID。通常の拠点の API の権限は持たない"
          },
          "kind": {
            "$ref": "#/components/schemas/ExperienceProviderKind"
          },
          "displayName": {
            "type": "string",
            "maxLength": 100
          },
          "bio": {
            "type": "string",
            "maxLength": 4000
          },
          "sellerDisclosureUrl": {
            "type": "string",
            "nullable": true,
            "description": "提供者が管理する特定商取引法の表示ページ（https）。未設定は null で、審査を申請できない"
          },
          "reviewStatus": {
            "$ref": "#/components/schemas/ExperienceProviderReviewStatus"
          },
          "consentVersion": {
            "type": "string",
            "description": "登録で同意した版"
          },
          "consentedAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
